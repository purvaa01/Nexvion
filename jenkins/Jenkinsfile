pipeline {
    agent any

    environment {
        IMAGE_NAME = "purvaawankhede/nexvion"
        IMAGE_TAG  = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Nexvion is a static frontend application.'
                echo 'No package manager dependencies are required.'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    test -f index.html
                    test -f products.html
                    test -f payment.html
                    echo "Nexvion application files verified."
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    test -f index.html
                    test -f products.html
                    test -f payment.html
                    echo "Basic application validation passed."
                '''
            }
        }

        stage('Security Checks') {
            steps {
                sh '''
                    trivy fs \
                    --scanners vuln,secret \
                    --severity HIGH,CRITICAL \
                    --exit-code 0 \
                    --no-progress \
                    .
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -f docker/Dockerfile \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    .
                '''
            }
        }

        stage('Image Scan') {
            steps {
                sh '''
                    trivy image \
                    --scanners vuln \
                    --severity HIGH,CRITICAL \
                    --exit-code 0 \
                    --no-progress \
                    ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }

        stage('Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_PASSWORD" | docker login \
                            -u "$DOCKERHUB_USERNAME" \
                            --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                        docker push ${IMAGE_NAME}:latest

                        docker logout
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker compose -f docker/docker-compose.yml up -d
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                     curl --fail --max-time 10 http://localhost:8081
                '''
            }
        }
    }

    post {
        success {
            echo 'Nexvion CI/CD pipeline completed successfully.'
        }

        failure {
            echo 'Nexvion CI/CD pipeline failed.'
        }
    }
}