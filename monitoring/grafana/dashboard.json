{
  "title": "Nexvion Kubernetes Health",
  "panels": [
    {
      "title": "Nexvion Pod Count",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=\"nexvion\"})",
          "legendFormat": "Pods"
        }
      ]
    },
    {
      "title": "Available Nexvion Replicas",
      "type": "stat",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"nexvion\"}",
          "legendFormat": "Available Replicas"
        }
      ]
    },
    {
      "title": "Nexvion Pod Status",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_pod_status_ready{namespace=\"nexvion\",condition=\"true\"})",
          "legendFormat": "Ready Pods"
        }
      ]
    },
    {
      "title": "Node Status",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "Ready Nodes"
        }
      ]
    },
    {
      "title": "Application Availability",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\"nexvion.*\"}",
          "legendFormat": "Application"
        }
      ]
    },
    {
      "title": "Nexvion Pod CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"nexvion\",container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Nexvion Pod Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"nexvion\",container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
