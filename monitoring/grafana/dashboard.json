{
  "title": "Nexvion Kubernetes Health",
  "panels": [
    {
      "title": "Nexvion Pods",
      "type": "stat",
      "targets": [
        {
          "expr": "count(kube_pod_info{namespace=\"nexvion\"})",
          "legendFormat": "Pods"
        }
      ]
    },
    {
      "title": "Available Nexvion Replicas",
      "type": "stat",
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"nexvion\"}",
          "legendFormat": "Available Replicas"
        }
      ]
    },
    {
      "title": "Nexvion Pod CPU Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"nexvion\",container!=\"\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Nexvion Pod Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"nexvion\",container!=\"\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
